# Never bake secrets, deployment state, backups or local user uploads into an image.
.git
.github
.gitignore
.dockerignore
.vscode
.idea
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
**/.aws
**/.ssh
**/.secrets
**/secrets
**/secrets/**
**/auth.json
**/id_rsa
**/id_ed25519
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Dependencies are installed as part of the Docker build, not copied from the host.
vendor
**/vendor
node_modules
**/node_modules

# Persistent host uploads and public volume content are not part of the app image.
storage-public
storage-public/**
**/storage-public
**/storage-public/**
public/build
public/hot
public/storage
**/public/build
**/public/storage
storage/framework
storage/logs
storage/pail
**/storage/logs
**/storage/logs/**
**/storage/framework
**/storage/framework/**
bootstrap/cache/*.php

# Backup/data files.
backups
**/backups
**/backups/**
**/*.sql
**/*.sql.gz
**/*.dump
**/*.sqlite
**/*.db
**/*.log
**/*.tmp
**/*.swp
**/*~
**/*.tar.gz.gpg
**/*.age
**/*.gpg

# Files not needed in build contexts.
docker-compose.yml
docker-compose.*.yml
**/Dockerfile
Dockerfile
dist
**/dist
coverage
**/coverage
**/__pycache__
**/*.pyc

storage/app/public
storage/app/public/**
storage/app/private
storage/app/private/**